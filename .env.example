# =============================================================================
# .env.example — copy to .env.local and fill in.
# Never commit .env.local. Read CLAUDE.md §10 before adding new variables.
# =============================================================================

# --- Database --------------------------------------------------------------
# Neon free-tier connection string. Use a dev branch locally; main branch in
# production. Format: postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgres://user:password@host.neon.tech/transformer_explainer?sslmode=require

# --- Auth.js ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app — create one at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- App -------------------------------------------------------------------
# Used for absolute URLs (OG tags, OAuth redirects in prod).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of GitHub logins granted admin access to /admin.
ADMIN_GITHUB_LOGINS=BrendanJamesLynskey

# --- Compute limits (server-side enforcement, see SPEC §4 + §7) ------------
MAX_SEQ_LEN=16
MAX_D_MODEL=64
MAX_BLOCKS=4

# --- Optional -------------------------------------------------------------
# Set to "true" in CI; gates dev-only features (e.g. /learn/_demos).
NEXT_PUBLIC_DEV_DEMOS_ENABLED=false
