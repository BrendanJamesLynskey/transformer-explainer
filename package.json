{
  "name": "transformer-explainer",
  "version": "0.1.0",
  "private": true,
  "description": "A graphical, interactive web explainer of the Transformer decoder.",
  "license": "MIT",
  "author": "Brendan Lynskey <https://github.com/BrendanJamesLynskey>",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-db.ts",
    "verify:maths": "tsx scripts/verify-maths.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "prepare-fixtures": "echo 'Run scripts/reference.py manually with Python + PyTorch; commits go to tests/unit/fixtures/'"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.2",
    "d3": "^7.9.0",
    "drizzle-orm": "^0.36.0",
    "drizzle-zod": "^0.5.1",
    "isomorphic-dompurify": "^2.16.0",
    "marked": "^14.1.3",
    "nanoid": "^5.0.7",
    "next": "14.2.15",
    "next-auth": "5.0.0-beta.22",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.3.0",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.48.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.16.13",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.27.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
